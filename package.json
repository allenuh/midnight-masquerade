{
  "name": "creature-containment-crew",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "playtest": "npm run build && npm run playtest:serve",
    "playtest:serve": "node --env-file-if-exists=.env dist/server/index.js --production",
    "start": "npm run playtest:serve",
    "map-editor": "vite --config tools/map-editor/vite.config.ts",
    "build:map-editor": "vite build --config tools/map-editor/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
