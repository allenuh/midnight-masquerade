# Server settings for `npm run playtest` / `npm start`. Copy this file to `.env` to use it;
# every line is optional and these are the defaults. `.env` is git-ignored. Gameplay
# tuning does not live here: see src/shared/gameplay-config.ts.

# Interface to listen on. 127.0.0.1 is enough for a Cloudflare Tunnel on this machine;
# 0.0.0.0 also lets other computers on your LAN connect (expect a firewall prompt).
HOST=127.0.0.1

# The one port the page and its WebSocket share. Point the tunnel at it.
PORT=5173

# Match length override, in seconds (the tunable default is 180).
# MATCH_SECONDS=180

# The map new rooms open on: a filename in maps/ without .json.
# MAP=test-arena

# One server-side balance line per room per second (all four proximity bands).
# DEBUG_SERVER=1
